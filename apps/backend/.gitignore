# ─── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo

# ─── Virtual environment ──────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Environment / secrets ────────────────────────────────────
# Ignore every env file by default so a real secret can never be
# committed by accident. The one exception is .env.test, un-ignored
# below: it holds only fake values and CI needs it to run.
.env
.env.dev
.env.local
.env.production
*.env

# Allow the fake test env through (no real secrets live here).
!.env.test

# ─── Distribution / build ─────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ─── Testing ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Alembic ──────────────────────────────────────────────────
# Keep migrations tracked, ignore only local state
alembic/versions/*.pyc

# ─── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ─── Celery ───────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid